<nav class="main-nav">
  <% if current_page?(profile_path) %>
    <%= link_to "Главная", root_path, class: "nav-link" %>
    <%= link_to "Личный кабинет", profile_path, class: "nav-link no-color-change" %>
    <%= link_to "Просмотр словарей",dictionaries_path, class: "nav-link no-color-change" %>


    <% if User.find(session[:user_id]).temp %>
      <%= link_to 'Авторизация', login_path, class: "nav-link" %>
      <%= link_to 'Зарегистрироваться', signup_path, class: "nav-link" %>

    <% else %>
      <%= button_to 'Выйти', logout_path, method: :delete, class: "btn btn-link nav-link" %>
    <% end %>



  <% else %>
    <%= link_to "Главная", root_path, class: "nav-link" %>
    <%if session[:user_id].present? %>
      <%= link_to "Личный кабинет", profile_path, class: "nav-link no-color-change" %>
      <%= link_to "Просмотр словарей",dictionaries_path, class: "nav-link no-color-change" %>
      <% if User.find(session[:user_id]).temp %>
        <%= link_to 'Авторизация', login_path, class: "nav-link" %>
        <%= link_to 'Зарегистрироваться', signup_path, class: "nav-link" %>

      <% else %>
        <%= button_to 'Выйти', logout_path, method: :delete, class: "btn btn-link nav-link" %>
      <% end %>

    <%else %>
      <%= link_to 'Авторизация', login_path, class: "nav-link" %>
      <%= link_to 'Зарегистрироваться', signup_path, class: "nav-link" %>

<% end %>


  <% end %>
</nav>
