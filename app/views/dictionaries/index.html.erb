<table class="table table-responsive table-striped ">
  <thead>
  <tr>
    <th> №</th>
    <th>Link</th>
    <th>Edited at</th>
  </tr>
  </thead>
  <tbody>

  <% @dicts.each_with_index do |dict, index| %>>
    <tr>
      <td><%= index+1 %></td>
      <td><%= link_to "#{dict.link}", dictionary_path(dict.id) %></td>
      <td><%= dict.created_at %></td>
    </tr>
  <% end %>

  </tbody>
</table>
